{
  "type": "object",
  "properties": {
    "uadsVersion": {
      "type": "string",
      "minLength": 1
    },
    "manifestVersion": {
      "const": 1
    },
    "project": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "pattern": "^[\\w.-]+/[\\w.-]+$"
        },
        "profiles": {
          "type": "array",
          "items": {
            "enum": [
              "mobile-app",
              "web-app",
              "backend-service",
              "desktop-app",
              "web-service",
              "cli-tool",
              "library",
              "hybrid"
            ]
          },
          "uniqueItems": true
        },
        "frameworks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "platforms": {
          "type": "array",
          "items": {
            "enum": [
              "ios",
              "ipados",
              "web",
              "linux",
              "android",
              "macos",
              "windows"
            ]
          },
          "uniqueItems": true
        },
        "hosting": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "repository",
        "profiles",
        "frameworks",
        "platforms",
        "hosting"
      ],
      "additionalProperties": false
    },
    "features": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "enum": [
          "implemented",
          "partial",
          "pending"
        ]
      }
    },
    "distribution": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "quality": {
      "type": "object",
      "properties": {
        "workflow": {
          "type": "string",
          "minLength": 1
        },
        "budgets": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "workflow",
        "budgets"
      ],
      "additionalProperties": false
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^UADS-[A-Z]+-[0-9]{3}$"
          },
          "applicability": {
            "enum": [
              "required",
              "conditional",
              "optional",
              "not-applicable",
              "approved-exception"
            ]
          },
          "state": {
            "enum": [
              "pending",
              "passed",
              "failed",
              "blocked",
              "not-applicable",
              "waived"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "applicability",
          "state",
          "evidence"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "platforms": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "risk": {
            "type": "string",
            "minLength": 1
          },
          "mitigation": {
            "type": "string",
            "minLength": 1
          },
          "approval": {
            "type": "string",
            "minLength": 1
          },
          "approvedOn": {
            "type": "string",
            "format": "date"
          },
          "reviewOn": {
            "type": "string",
            "format": "date"
          },
          "reconsideration": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "platforms",
          "reason",
          "risk",
          "mitigation",
          "approval",
          "approvedOn",
          "reviewOn",
          "reconsideration"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    }
  },
  "required": [
    "uadsVersion",
    "manifestVersion",
    "project",
    "features",
    "distribution",
    "quality",
    "requirements",
    "exceptions"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
