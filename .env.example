# Set a unique initial administrator password (14+ characters). Used only at first boot.
FETCH_ADMIN_PASSWORD=
FETCH_DATA=/data
FETCH_CONCURRENCY=2
FETCH_MAX_BYTES=2147483648
FETCH_MAX_SECONDS=3600
FETCH_MIN_FREE=536870912
FETCH_RETENTION_HOURS=168
FETCH_DISTRIBUTION=extended
# Exact source domains, comma separated. Required and fail-closed for store configuration.
FETCH_SOURCE_HOSTS=

# Optional private GitHub release metadata bridge. Keep token server-side only.
FETCH_RELEASE_REPOSITORY=
FETCH_RELEASE_TOKEN=
