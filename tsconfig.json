{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "outDir": "web",
    "rootDir": "web/src",
    "skipLibCheck": true
  },
  "include": [
    "web/src/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
